# ai-image pipeline configuration template
# Run `make config` to generate config.yaml with auto-detected values.
# This file is version-controlled. config.yaml is generated and gitignored.

paths:
  root: auto          # auto: parent directory of this file
  comfyui: auto       # auto: {root}/loop/ComfyUI
  output: auto        # auto: {root}/loop/output
  scorers: auto       # auto: {root}/loop/scorers

models:
  vlm:
    dir: auto                                      # auto: {scorers}/models/vlm
    filename: Qwen3-VL-8B-Instruct-abliterated-v2.Q8_0.gguf
    source: hf:prithivMLmods/Qwen3-VL-8B-Instruct-abliterated-v2-GGUF/Qwen3-VL-8B-Instruct-abliterated-v2.Q8_0.gguf
    mmproj_filename: Qwen3-VL-8B-Instruct-abliterated-v2.mmproj-Q8_0.gguf
    mmproj_source: hf:prithivMLmods/Qwen3-VL-8B-Instruct-abliterated-v2-GGUF/Qwen3-VL-8B-Instruct-abliterated-v2.mmproj-Q8_0.gguf
    context_length: 4096
  artifact_detector:
    dir: auto          # auto: {scorers}/models/artifact-detector
    source: hf:umm-maybe/AI-image-detector        # public repo, no token required
  clip:
    name: ViT-L-14
    pretrained: openai

  # ── Generative model checkpoints ──────────────────────────────────────────
  sdxl:
    # Filename as it appears in ComfyUI's checkpoints directory.
    # Used by comfyui_worker to patch workflows when model_type == "sdxl".
    checkpoint: ""   # e.g. realisticVisionV60B1_v51VAE.safetensors

  flux:
    # Flux weights are split across four separate files.
    # Filenames as they appear in ComfyUI's model subdirectories.
    unet:   ""       # ComfyUI/models/unet/   e.g. flux1-dev.safetensors
    vae:    ""       # ComfyUI/models/vae/    e.g. ae.safetensors
    clip_l: ""       # ComfyUI/models/clip/   e.g. clip_l.safetensors
    t5xxl:  ""       # ComfyUI/models/clip/   e.g. t5xxl_fp16.safetensors

  # ── LoRA registry ─────────────────────────────────────────────────────────
  # Each entry is available to the tactical LLM as a named choice.
  # source: hf:<repo_id>/<filename> | civitai:<model_version_id> | local:<filename>
  #
  # trigger_word (optional): if the LoRA requires a trigger word in the prompt,
  #   set it here. The tactical LLM will include it in retry/inpaint prompts and
  #   set strength_clip > 0 so the text encoder recognises the concept.
  #   Omit (or leave blank) for style/detail LoRAs that need no trigger.
  loras:
    sdxl: []
    # Example SDXL LoRA entry:
    # - name: DetailTweaker
    #   filename: detail_tweaker_xl.safetensors
    #   description: Enhances fine detail and texture sharpness in skin, fabric, and surfaces
    #   source: civitai:135867
    #   default_strength: 0.7
    #   # trigger_word: ""   # omit — no trigger needed

    # Example SDXL LoRA with trigger word:
    # - name: PerfectHands
    #   filename: perfect_hands_v2.safetensors
    #   description: Corrects common anatomical hand errors (extra fingers, fused joints)
    #   source: civitai:198540
    #   default_strength: 0.8
    #   trigger_word: "perfect hands"

    flux: []
    # Example Flux LoRA entry:
    # - name: FluxRealism
    #   filename: flux_realism_lora.safetensors
    #   description: Improves photorealism and skin texture for Flux
    #   source: hf:XLabs-AI/flux-RealismLora/flux_realism_lora.safetensors
    #   default_strength: 0.8
    #   # trigger_word: ""   # omit — no trigger needed

compute:
  # Per-component compute target configuration.
  # backend: auto | mps | cuda | rocm | cpu
  #   auto  — detect at startup (macOS → mps; NVIDIA → cuda; AMD → rocm; else → cpu)
  #   mps   — Apple Metal Performance Shaders (macOS / Apple Silicon)
  #   cuda  — NVIDIA CUDA (Linux/Windows)
  #   rocm  — AMD ROCm (Linux; uses CUDA device naming in PyTorch)
  #   cpu   — CPU only
  comfyui:
    backend: auto
    listen: 0.0.0.0       # address ComfyUI binds to; 0.0.0.0 = all interfaces
                          # set to 127.0.0.1 to restrict to localhost only
    device_id:            # optional: integer device index passed as --default-device
                          # useful when multiple GPUs are present (e.g. eGPU via Thunderbolt)
                          # omit or leave blank to use the default device
  clip_scorer:
    backend: auto
  artifact_scorer:
    backend: auto
  vlm_scorer:
    backend: auto
  # tactical_llm and strategic_llm are served by mlx_lm.server (Apple Silicon only).
  # MLX handles device placement and MoE expert streaming natively — no manual layer
  # offload flags. The models below are MoE; inactive expert arrays are demand-paged
  # from SSD by the MLX runtime as needed.
  tactical_llm:
    backend: mlx
  strategic_llm:
    backend: mlx

thresholds:
  clip: 0.25
  artifact: 0.50
  score_timeout_secs: 60

broker:
  url: tcp://localhost:61616            # Artemis OpenWire — Java pipeline connects here
                                        # K3s NodePort: tcp://<node-ip>:30616
                                        # Remote/virt cluster: set to the broker's external address
  artemis_console: http://localhost:8161
  comfyui_url: http://127.0.0.1:8188
  comfyui_ws: ws://127.0.0.1:8188/ws

database:
  postgres_url: jdbc:postgresql://localhost:5432/pipeline   # override for K8s: jdbc:postgresql://postgres:5432/pipeline
  username: pipeline
  password: pipeline

system:
  package_manager: auto   # auto | homebrew | apt | dnf | pacman | zypper
  homebrew_prefix: auto   # auto | /opt/homebrew (Apple Silicon) | /usr/local (Intel)

tactical:
  model:
    dir: auto         # auto: {paths.scorers}/models/tactical
    # MLX models are directories, not single files. `name` is the subdirectory within dir.
    name: Huihui-Qwen3-Next-80B-A3B-Instruct-abliterated-mlx-4bit
    source: hf:huihui-ai/Huihui-Qwen3-Next-80B-A3B-Instruct-abliterated-mlx-4bit
    context_length: 8192
    temperature: 0.1  # low for deterministic decisions
    max_tokens: 128              # SD 1.5 generates in 3–8s; decisions must be concise
    max_tokens_thinking: 512     # thinking budget for borderline/escalate re-queries only
    server_url: http://localhost:8080/v1   # mlx_lm.server OpenAI-compatible endpoint
    model_name: default
  decisions:
    max_retries: 3    # retry budget per session
    max_inpaints: 2   # inpaint budget per session
    accept_vlm_mean_min: 7.0   # minimum mean VLM score to accept a candidate
    accept_clip_min: 0.30      # minimum CLIP score to accept a candidate
    thinking_score_threshold: 0.05  # re-query with thinking if best score within this margin of threshold

strategic:
  model:
    dir: auto         # auto: {paths.scorers}/models/strategic
    # Raw HuggingFace bf16 safetensors — no conversion needed. mlx_lm.server loads
    # arrays lazily; inactive expert weights are demand-paged from SSD by the MLX
    # runtime. Working set ~40–50 GB; full model ~160 GB on disk.
    name: Huihui-Qwen3-Next-80B-A3B-Thinking-abliterated
    source: hf:huihui-ai/Huihui-Qwen3-Next-80B-A3B-Thinking-abliterated
    context_length: 32768
    temperature: 0.6  # higher than tactical; strategic review benefits from exploration
    server_url: http://localhost:8081/v1   # separate port — Loop and Strategic never run together
    model_name: default

ui:
  port: 7860           # port the browser UI listens on
  host: 0.0.0.0        # bind address; set to 127.0.0.1 to restrict to localhost
  # chat_backend: override which LLM server the chat panel talks to.
  # Defaults to tactical.model.server_url / model_name when omitted.
  # Set this to the strategic LLM server when running a strategic session.
  # chat_backend:
  #   server_url: http://localhost:8081/v1
  #   model_name: default
